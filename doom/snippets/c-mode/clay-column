# -*- mode: snippet -*-
# name: Clay Column
# key: clcol
# group: Clay
# expand-env: ((yas-indent-line 'fixed))
# --
CLAY({
    .id = CLAY_ID("${1:Column}"),
    .layout = {
        .layoutDirection = CLAY_TOP_TO_BOTTOM,
        .childGap = ${2:8},
        .padding = CLAY_PADDING_ALL(${3:0}),
    },
}) {
    $0
}
